# .env.example — Copy this to .env and fill in your values
# The .env file is NEVER committed to the repo (it is gitignored).

# ── Gemini Web2API Proxy Settings ──
# Leave these blank if you use the default unauthenticated proxy.
# Add your Gemini session cookies here if you want to use your own account.
GEMINI_COOKIES=

# ── Agent Backend Settings ──
# The backend runs on localhost:5000 by default.
BACKEND_PORT=5000

# ── Proxy Settings ──
# The Web2API proxy runs on localhost:8081 by default.
PROXY_PORT=8081
