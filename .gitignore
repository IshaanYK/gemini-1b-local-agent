# Gemini 1B Local Agent — .gitignore

# ── Sensitive / user-specific files (NEVER commit these) ──
.env
permissions.json
gemini-chatbox/permissions.json
gemini-chatbox/storage/permissions.json
*.db
*.sqlite
*.log
user_profile.json
gemini-chatbox/user_profile.json
gemini-chatbox/storage/user_profile.json

# ── Temporary Uploads & Screenshot Artifacts ──
gemini-chatbox/uploads/
gemini-chatbox/b1_*.png
gemini-chatbox/storage/*.db
gemini-chatbox/storage/google_drive_sync/
gemini-chatbox/handoff_context.json
playground/

# ── Python / Node Cache ──
__pycache__/
*.pyc
*.pyo
node_modules/
venv/
.venv/
.DS_Store
Thumbs.db

