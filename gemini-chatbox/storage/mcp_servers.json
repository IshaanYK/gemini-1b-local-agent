{
  "mcpServers": {
    "mcp-filesystem": {
      "name": "Local Filesystem MCP",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "env": {},
      "source": "local",
      "enabled": true
    },
    "mcp-memory": {
      "name": "Knowledge Graph Memory MCP",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {},
      "source": "local",
      "enabled": true
    },
    "github-mcp": {
      "name": "github-mcp",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      },
      "source": "local",
      "enabled": true
    }
  }
}